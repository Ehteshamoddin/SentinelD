{
  "daemon": {
    "pid_file": "/run/sentineld/sentineld.pid",
    "log_file": "/var/log/sentineld/sentineld.log",
    "log_level": "info"
  },
  "monitor": {
    "interval_seconds": 5,
    "cpu_threshold_percent": 90,
    "memory_threshold_percent": 85
  },
  "watcher": {
    "path": "/etc/sentineld",
    "events": ["create", "modify", "delete", "move"]
  }
}
